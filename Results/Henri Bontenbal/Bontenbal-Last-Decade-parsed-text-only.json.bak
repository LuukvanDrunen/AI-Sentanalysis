  { "text": "@vermeerjenny @CDAWestland @cdavandaag 💪💪" },
  {
    "text": "@marksremarks @bnrpolitiek @sophievleeuwen @LeendertBeekman @mirjambikker @MinisterEZK @RenskeLeijten @Sneller Blijven oefenen is het devies :)"
  },
  {
    "text": "@RonStoop1 Je ziet nu dat EDF het onderhoud van haar kerncentrales niet op orde had."
